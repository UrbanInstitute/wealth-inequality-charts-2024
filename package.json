{
  "name": "dataviz-project-starter-kit",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "content": "node data/scripts/build_content.js",
    "update-charts": "Rscript data/scripts/update_charts.R",
    "publish-charts": "Rscript data/scripts/publish_charts.R",
    "prep-2026": "Rscript data/scripts/prep_2026.R",
    "copy-charts-2026": "Rscript data/scripts/copy_charts_2026.R",
    "upload-data-2026": "Rscript data/scripts/upload_data_2026.R",
    "snapshot-locked": "Rscript data/scripts/snapshot_locked.R",
    "test-dw-guard": "Rscript data/scripts/test_dw_guard.R"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/ui": "^5.0.5",
    "archieml": "^0.5.0",
    "d3-dsv": "^3.0.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@urbaninstitute/dataviz-components": "^2.2.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/lib/components/*",
    "#data/*": "./src/data/*"
  }
}
